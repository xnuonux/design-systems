/* ============================================================
   {{projectName}} — Typography
   ------------------------------------------------------------
   {{#if hasSeparateBody}}Three voices:{{else}}Two voices (mono-forward):{{/if}}
   · {{displayFont}}         {{#if hasSeparateBody}}DISPLAY{{else}}TITLE — italic, used sparingly{{/if}}
   {{#if hasSeparateBody}}· {{bodyFont}}         BODY — clean, functional.
   {{/if}}· {{monoFont}} {{#if hasSeparateBody}}READOUT — timestamps, params, data.{{else}}   — the entire interface.{{/if}}
   ============================================================ */

{{#if isCinzel}}
@import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family={{#if hasSeparateBody}}{{bodyFont}}:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family={{/if}}{{monoFont}}:ital,wght@0,100..800;1,100..800&display=swap");
{{/if}}
{{#if isCrimson}}
@import url("https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family={{#if hasSeparateBody}}{{bodyFont}}:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family={{/if}}{{monoFont}}:ital,wght@0,100..800;1,100..800&display=swap");
{{/if}}
{{#if isEBGaramond}}
@import url("https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family={{#if isIBM}}{{monoFont}}:ital,wght@0,400;0,500;0,600;1,400{{else}}{{monoFont}}:ital,wght@0,100..800;1,100..800{{/if}}&display=swap");
{{/if}}

:root {
  /* ── Families ── */
  --font-display: "{{displayFont}}", Georgia, serif;
  --font-body:    "{{#if hasSeparateBody}}{{bodyFont}}{{else}}{{monoFont}}{{/if}}", {{#if hasSeparateBody}}ui-sans-serif, system-ui, sans-serif{{else}}ui-monospace, monospace{{/if}};
  --font-mono:    "{{monoFont}}", ui-monospace, monospace;

  /* ── Weights ── */
  --weight-regular:  400;
  --weight-medium:   500;
  --weight-semibold: 600;
  --weight-bold:     700;

  /* ── Type scale (rem) ── */
  --text-xs:    0.75rem;
  --text-sm:    0.875rem;
  --text-base:  1rem;
  --text-md:    1.1875rem;
  --text-lg:    1.5rem;
  --text-xl:    2rem;
  --text-2xl:   2.75rem;
  --text-hero:  clamp(2.4rem, 6vw, 5rem);

  /* ── Line height ── */
  --leading-tight:  1.08;
  --leading-snug:   1.25;
  --leading-body:   1.6;

  /* ── Letter-spacing ── */
  --tracking-display: 0.28em;
  --tracking-label:   0.14em;
}

/* ── Text presets ── */

{{#if hasDisplayFont}}
.ds-display {
  font-family: var(--font-display);
  font-weight: var(--weight-regular);
  font-size: var(--text-hero);
  line-height: var(--leading-tight);
  letter-spacing: 0.04em;
  color: var(--text-strong);
}

.ds-h1 { font-family: var(--font-display); font-weight: var(--weight-regular); font-size: var(--text-2xl); line-height: var(--leading-tight); color: var(--text-strong); }
.ds-h2 { font-family: var(--font-display); font-weight: var(--weight-regular); font-size: var(--text-xl); line-height: var(--leading-snug); color: var(--text-strong); }
{{else}}
.ds-title {
  font-family: var(--font-display);
  font-weight: var(--weight-regular);
  font-style: italic;
  font-size: var(--text-lg);
  line-height: 1.3;
  color: var(--text-strong);
}
{{/if}}

.ds-h3 { font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: var(--text-lg); line-height: var(--leading-snug); color: var(--text-strong); }
.ds-body { font-family: var(--font-body); font-weight: var(--weight-regular); font-size: var(--text-base); line-height: var(--leading-body); color: var(--text-body); }
.ds-small { font-family: var(--font-body); font-weight: var(--weight-regular); font-size: var(--text-sm); color: var(--text-muted); }

.ds-mono { font-family: var(--font-mono); font-weight: var(--weight-regular); font-size: var(--text-sm); letter-spacing: 0.02em; color: var(--text-body); }
.ds-label {
  font-family: var(--font-mono);
  font-weight: var(--weight-medium);
  font-size: var(--text-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
}
